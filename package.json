{
  "name": "rufact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:ml": "uv run --project ml uvicorn rufact_ml.main:app --app-dir ml/src --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:gemini": "node --env-file=.env.local --experimental-strip-types scripts/check-gemini.mjs",
    "test:gemini": "node --test --experimental-strip-types tests/gemini-review.test.mjs",
    "test:tavily": "node --test --experimental-strip-types tests/tavily-search.test.mjs",
    "test:report": "node --test --experimental-strip-types tests/analysis-report.test.mjs",
    "test:api": "node --test --experimental-strip-types tests/api-client.test.mjs",
    "test:verdict": "node --test --experimental-strip-types tests/verdict.test.mjs",
    "test:security": "node --test --experimental-strip-types tests/security.test.mjs",
    "test:telegram": "node --test --experimental-strip-types tests/telegram.test.mjs",
    "test:chat": "node --test --experimental-strip-types tests/chat.test.mjs",
    "telegram:setup": "node --env-file=.env.local scripts/setup-telegram.mjs",
    "test:unit": "npm run test:gemini && npm run test:tavily && npm run test:report && npm run test:api && npm run test:verdict && npm run test:security && npm run test:telegram && npm run test:chat",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run lint:ml && npm run test:ml",
    "train:ml": "uv run --project ml rufact-train",
    "train:ml:en": "uv run --project ml rufact-train-en",
    "test:ml": "uv run --project ml pytest",
    "lint:ml": "uv run --project ml ruff check ml"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.137",
    "framer-motion": "13.4.4",
    "lucide-react": "1.48.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
