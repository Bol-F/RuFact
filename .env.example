# Server-only FastAPI endpoint. Do not prefix this variable with NEXT_PUBLIC_.
ML_API_URL=http://127.0.0.1:8000/predict

# Shared by the Next.js server and FastAPI. Generate at least 32 random bytes.
# Example: openssl rand -base64 48
ML_API_JWT_SECRET=

# Distributed public rate limiting (required when NODE_ENV=production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace aliases accepted by the app:
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_HASH_SECRET=
RATE_LIMIT_NAMESPACE=rufact
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
EXTRACT_RATE_LIMIT_MAX_REQUESTS=4
EXTRACT_RATE_LIMIT_WINDOW_SECONDS=60
INTERNET_RATE_LIMIT_MAX_REQUESTS=5
INTERNET_RATE_LIMIT_WINDOW_SECONDS=300
# Shared Tavily/Gemini budget across all clients. Roughly 30/day stays near 1000/month.
INTERNET_DAILY_MAX_REQUESTS=30

# Optional server-only Gemini second opinion. Keep disabled until a fresh key is set.
GEMINI_REVIEW_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=

# Telegram bot: server-only BotFather token, plus an independent random webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_APP_URL=https://rufact.vercel.app

# Voluntary Telegram Stars support. Keep disabled until owner approval, provider
# eligibility, payment support, refund procedure and test-environment checks.
# Uses the SAME bot, webhook, Redis REST credentials and RATE_LIMIT_HASH_SECRET.
SUPPORT_STARS_ENABLED=false
# Real, monitored HTTPS payment-help contact; required before Stars can activate.
SUPPORT_CONTACT_URL=
SUPPORT_RATE_LIMIT_MAX=5
SUPPORT_RATE_LIMIT_WINDOW_SECONDS=600
# Shared invoice-creation allowance across website and Telegram, not Stars spent.
SUPPORT_DAILY_LIMIT=100
# Reserved only: setting true does NOT implement or activate Wallet/crypto.
SUPPORT_WALLET_ENABLED=false

# FastAPI production hardening.
RUFACT_ENV=development
RUFACT_ALLOWED_HOSTS=localhost,127.0.0.1
RUFACT_API_DOCS_ENABLED=false
RUFACT_MAX_CONCURRENT_PREDICTIONS=4
RUFACT_PREDICTION_QUEUE_TIMEOUT_MS=500
RUFACT_UVICORN_LIMIT_CONCURRENCY=16
RUFACT_UVICORN_BACKLOG=64
